rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profile validation
    function isValidUser(data, userId) {
      return data.id == userId &&
        data.email is string &&
        data.email.size() > 0 &&
        data.email.size() <= 200;
    }

    // Word item validation
    function isValidWord(data, userId) {
      return data.userId == userId &&
        data.word is string &&
        data.word.size() > 0 &&
        data.word.size() <= 200 &&
        data.meanings is list &&
        data.meanings.size() > 0 &&
        data.meanings.size() <= 30 &&
        data.status in ['new', 'learning', 'mastered'];
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming(), userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      // User's private vocabulary words subcollection
      match /words/{wordId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(wordId) && isValidWord(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(wordId) && isValidWord(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(wordId);
      }
    }
  }
}
